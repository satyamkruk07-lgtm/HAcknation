{
  "entities": {
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents a Hackathon event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event."
        },
        "name": {
          "type": "string",
          "description": "Name of the event."
        },
        "description": {
          "type": "string",
          "description": "Description of the event."
        },
        "startDate": {
          "type": "string",
          "description": "Start date and time of the event.",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "End date and time of the event.",
          "format": "date-time"
        },
        "location": {
          "type": "string",
          "description": "Location of the event."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "startDate",
        "endDate",
        "location"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user participating in the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "skills": {
          "type": "array",
          "description": "Skills of the user.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "skills"
      ]
    },
    "Team": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team",
      "type": "object",
      "description": "Represents a team participating in the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the team."
        },
        "name": {
          "type": "string",
          "description": "Name of the team."
        },
        "memberIds": {
          "type": "array",
          "description": "References to Users. (Relationship: Team 1:N User)",
          "items": {
            "type": "string"
          }
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Team)"
        }
      },
      "required": [
        "id",
        "name",
        "memberIds",
        "eventId"
      ]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a project submitted to the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "teamId": {
          "type": "string",
          "description": "Reference to Team. (Relationship: Team 1:N Project)"
        },
        "name": {
          "type": "string",
          "description": "Name of the project."
        },
        "description": {
          "type": "string",
          "description": "Description of the project."
        },
        "submissionLink": {
          "type": "string",
          "description": "Link to the project submission.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "teamId",
        "name",
        "description",
        "submissionLink"
      ]
    },
    "Judging": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Judging",
      "type": "object",
      "description": "Represents the judging of a project.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the judging."
        },
        "projectId": {
          "type": "string",
          "description": "Reference to Project. (Relationship: Project 1:N Judging)"
        },
        "judgeId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Judging)"
        },
        "score": {
          "type": "number",
          "description": "Score given by the judge."
        },
        "feedback": {
          "type": "string",
          "description": "Feedback given by the judge."
        }
      },
      "required": [
        "id",
        "projectId",
        "judgeId",
        "score",
        "feedback"
      ]
    },
    "Announcement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Announcement",
      "type": "object",
      "description": "Represents an announcement during the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the announcement."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the announcement.",
          "format": "date-time"
        },
        "content": {
          "type": "string",
          "description": "Content of the announcement."
        },
        "title": {
          "type": "string",
          "description": "Title of the announcement."
        },
        "type": {
          "type": "string",
          "description": "Type of announcement (e.g., 'Info', 'Update')."
        }
      },
      "required": [
        "id",
        "timestamp",
        "content",
        "title",
        "type"
      ]
    },
    "ScheduleItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ScheduleItem",
      "type": "object",
      "description": "Represents an item in the event schedule.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the schedule item."
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N ScheduleItem)"
        },
        "startTime": {
          "type": "string",
          "description": "Start time of the schedule item.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "End time of the schedule item.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Description of the schedule item."
        },
        "location": {
          "type": "string",
          "description": "Location of the schedule item."
        }
      },
      "required": [
        "id",
        "eventId",
        "startTime",
        "endTime",
        "description",
        "location"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": {
            "$ref": "#/backend/entities/Event"
          },
          "description": "Stores event details.",
          "params": [
            {
              "name": "eventId",
              "description": "The unique identifier for the event."
            }
          ]
        }
      },
      {
        "path": "users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "announcements/{announcementId}",
        "definition": {
          "entityName": "Announcement",
          "schema": {
            "$ref": "#/backend/entities/Announcement"
          },
          "description": "Stores announcements for the event.",
          "params": [
            {
              "name": "announcementId",
              "description": "The unique identifier for the announcement."
            }
          ]
        }
      },
      {
        "path": "events/{eventId}/teams/{teamId}",
        "definition": {
          "entityName": "Team",
          "schema": {
            "$ref": "#/backend/entities/Team"
          },
          "description": "Stores team information for a given event. Includes denormalized `eventId` for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "The unique identifier for the event."
            },
            {
              "name": "teamId",
              "description": "The unique identifier for the team."
            }
          ]
        }
      },
      {
        "path": "events/{eventId}/scheduleItems/{scheduleItemId}",
        "definition": {
          "entityName": "ScheduleItem",
          "schema": {
            "$ref": "#/backend/entities/ScheduleItem"
          },
          "description": "Stores schedule items for a given event. Includes denormalized `eventId` for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "The unique identifier for the event."
            },
            {
              "name": "scheduleItemId",
              "description": "The unique identifier for the schedule item."
            }
          ]
        }
      },
      {
        "path": "teams/{teamId}/projects/{projectId}",
        "definition": {
          "entityName": "Project",
          "schema": {
            "$ref": "#/backend/entities/Project"
          },
          "description": "Stores project information for a given team.  Includes denormalized `teamId` for authorization independence.",
          "params": [
            {
              "name": "teamId",
              "description": "The unique identifier for the team."
            },
            {
              "name": "projectId",
              "description": "The unique identifier for the project."
            }
          ]
        }
      },
      {
        "path": "projects/{projectId}/judgings/{judgingId}",
        "definition": {
          "entityName": "Judging",
          "schema": {
            "$ref": "#/backend/entities/Judging"
          },
          "description": "Stores judging information for a given project. Includes denormalized `projectId` for authorization independence.",
          "params": [
            {
              "name": "projectId",
              "description": "The unique identifier for the project."
            },
            {
              "name": "judgingId",
              "description": "The unique identifier for the judging."
            }
          ]
        }
      },
      {
        "path": "roles_admin/{userId}",
        "definition": {
          "entityName": "roles_admin",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Indicates if a user has admin roles. Existence over content.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "users/{userId}/teams/{teamId}",
        "definition": {
          "entityName": "Team",
          "schema": {
            "$ref": "#/backend/entities/Team"
          },
          "description": "Stores teams created by a specific user.  Includes denormalized `userId` for authorization independence.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            },
            {
              "name": "teamId",
              "description": "The unique identifier for the team."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore data structure is designed to support the HackTrack application's features, including event schedules, registration, live updates, submission platform, judging, and team formation. The structure emphasizes authorization independence and supports secure list operations. It leverages path-based ownership for user-specific data and membership maps for collaborative entities.\n\nAuthorization Independence (CRITICAL): Achieved primarily through denormalization. For example, teams store the `eventId` directly, avoiding the need to `get()` the event document to check authorization.  Projects include the `teamId`.\n\nQAPs (Rules are not Filters): Supported through structural segregation. The `users/{userId}/teams` collection ensures only the user can list their own teams. The `announcements` collection allows listing announcements scoped to the event without filtering, as it's a top-level collection.\n\nThe top-level collections are `events`, `users`, `roles_admin`, and `announcements`. Events contain event-specific information, Users contain personal profiles, roles_admin contains the user ID when the user has admin rights, and announcements are global for the event."
  }
}

    