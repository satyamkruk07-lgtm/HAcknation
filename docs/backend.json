{
  "entities": {
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents a Hackathon event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Event entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the event."
        },
        "startDate": {
          "type": "string",
          "description": "Date and time when the event starts.",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "Date and time when the event ends.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the event."
        },
        "location": {
          "type": "string",
          "description": "Location of the event."
        },
        "websiteUrl": {
          "type": "string",
          "description": "URL of the event website.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "name",
        "startDate",
        "endDate",
        "description",
        "location"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user participating in the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user."
        },
        "registrationDate": {
          "type": "string",
          "description": "Date and time when the user registered.",
          "format": "date-time"
        },
        "skills": {
          "type": "array",
          "description": "Skills possessed by the user.",
          "items": {
            "type": "string"
          }
        },
        "teamId": {
          "type": "string",
          "description": "Reference to Team. (Relationship: User N:1 Team)"
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "registrationDate"
      ]
    },
    "Team": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team",
      "type": "object",
      "description": "Represents a team participating in the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Team entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the team."
        },
        "description": {
          "type": "string",
          "description": "Description of the team and its goals."
        },
        "submissionId": {
          "type": "string",
          "description": "Reference to Submission. (Relationship: Team 1:1 Submission)"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "ScheduleItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ScheduleItem",
      "type": "object",
      "description": "Represents an item in the event schedule.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the ScheduleItem entity."
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N ScheduleItem)"
        },
        "title": {
          "type": "string",
          "description": "Title of the schedule item."
        },
        "startTime": {
          "type": "string",
          "description": "Start time of the schedule item.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "End time of the schedule item.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Description of the schedule item."
        },
        "location": {
          "type": "string",
          "description": "Location of the schedule item."
        }
      },
      "required": [
        "id",
        "eventId",
        "title",
        "startTime",
        "endTime",
        "description",
        "location"
      ]
    },
    "Announcement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Announcement",
      "type": "object",
      "description": "Represents a real-time announcement during the event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Announcement entity."
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Announcement)"
        },
        "timestamp": {
          "type": "string",
          "description": "Time the announcement was made.",
          "format": "date-time"
        },
        "message": {
          "type": "string",
          "description": "Content of the announcement."
        }
      },
      "required": [
        "id",
        "eventId",
        "timestamp",
        "message"
      ]
    },
    "Submission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Submission",
      "type": "object",
      "description": "Represents a project submission by a team.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Submission entity."
        },
        "teamId": {
          "type": "string",
          "description": "Reference to Team. (Relationship: Team 1:1 Submission)"
        },
        "submissionTime": {
          "type": "string",
          "description": "Time the submission was made.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Description of the project."
        },
        "link": {
          "type": "string",
          "description": "Link to the project (e.g., GitHub repository, deployed application).",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "teamId",
        "submissionTime",
        "description",
        "link"
      ]
    },
    "JudgingCriteria": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "JudgingCriteria",
      "type": "object",
      "description": "Represents the criteria used for judging submissions.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the JudgingCriteria entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the criteria (e.g., Innovation, Technical Complexity)."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the criteria."
        },
        "maxScore": {
          "type": "number",
          "description": "Maximum possible score for this criteria."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "maxScore"
      ]
    },
    "Judge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Judge",
      "type": "object",
      "description": "Represents a judge evaluating submissions.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Judge entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the judge."
        },
        "email": {
          "type": "string",
          "description": "Email of the judge.",
          "format": "email"
        },
        "expertise": {
          "type": "string",
          "description": "Area of expertise of the judge."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "expertise"
      ]
    },
    "Score": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Score",
      "type": "object",
      "description": "Represents the score given to a submission by a judge for a specific criteria.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Score entity."
        },
        "submissionId": {
          "type": "string",
          "description": "Reference to Submission. (Relationship: Submission 1:N Score)"
        },
        "judgeId": {
          "type": "string",
          "description": "Reference to Judge. (Relationship: Judge 1:N Score)"
        },
        "criteriaId": {
          "type": "string",
          "description": "Reference to JudgingCriteria. (Relationship: JudgingCriteria 1:N Score)"
        },
        "score": {
          "type": "number",
          "description": "The score given by the judge for the criteria."
        },
        "feedback": {
          "type": "string",
          "description": "Feedback provided by the judge for the criteria."
        }
      },
      "required": [
        "id",
        "submissionId",
        "judgeId",
        "criteriaId",
        "score"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": {
            "$ref": "#/backend/entities/Event"
          },
          "description": "Stores event information.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information. Enforces path-based ownership - only the authenticated user can access their own profile.",
          "params": [
            {
              "name": "userId",
              "description": "Unique identifier for the user.  Matches the Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/teams/{teamId}",
        "definition": {
          "entityName": "Team",
          "schema": {
            "$ref": "#/backend/entities/Team"
          },
          "description": "Stores team information.",
          "params": [
            {
              "name": "teamId",
              "description": "Unique identifier for the team."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/scheduleItems/{scheduleItemId}",
        "definition": {
          "entityName": "ScheduleItem",
          "schema": {
            "$ref": "#/backend/entities/ScheduleItem"
          },
          "description": "Stores schedule items associated with a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "scheduleItemId",
              "description": "Unique identifier for the schedule item."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}/announcements/{announcementId}",
        "definition": {
          "entityName": "Announcement",
          "schema": {
            "$ref": "#/backend/entities/Announcement"
          },
          "description": "Stores announcements for a specific event. Includes denormalized 'eventId' for authorization independence.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            },
            {
              "name": "announcementId",
              "description": "Unique identifier for the announcement."
            }
          ]
        }
      },
      {
        "path": "/submissions/{submissionId}",
        "definition": {
          "entityName": "Submission",
          "schema": {
            "$ref": "#/backend/entities/Submission"
          },
          "description": "Stores project submissions.",
          "params": [
            {
              "name": "submissionId",
              "description": "Unique identifier for the submission."
            }
          ]
        }
      },
      {
        "path": "/judgingCriteria/{judgingCriteriaId}",
        "definition": {
          "entityName": "JudgingCriteria",
          "schema": {
            "$ref": "#/backend/entities/JudgingCriteria"
          },
          "description": "Stores judging criteria.",
          "params": [
            {
              "name": "judgingCriteriaId",
              "description": "Unique identifier for the judging criteria."
            }
          ]
        }
      },
      {
        "path": "/judges/{judgeId}",
        "definition": {
          "entityName": "Judge",
          "schema": {
            "$ref": "#/backend/entities/Judge"
          },
          "description": "Stores judge information.",
          "params": [
            {
              "name": "judgeId",
              "description": "Unique identifier for the judge."
            }
          ]
        }
      },
      {
        "path": "/scores/{scoreId}",
        "definition": {
          "entityName": "Score",
          "schema": {
            "$ref": "#/backend/entities/Score"
          },
          "description": "Stores scores given to submissions by judges.",
          "params": [
            {
              "name": "scoreId",
              "description": "Unique identifier for the score."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to support the HackTrack application's core features, emphasizing security, scalability, and ease of maintenance. Authorization independence is achieved by denormalizing authorization data where needed to avoid `get()` calls in security rules. Data is segregated into collections based on access patterns.\n\n**Authorization Independence:**\n*   The `events/{eventId}/scheduleItems` and `events/{eventId}/announcements` collections denormalize the `eventId` to ensure that security rules can validate that the parent event exists without needing a `get()` call.\n*   The `users/{userId}` collection represents private user data, secured via path-based rules.\n\n**Structural Segregation:**\n*   Events and Users are stored in top-level collections, enabling easy listing of all events and users.\n\n**Access Modeling:**\n*   Private user data (profile information) is stored under `/users/{userId}`, enforcing path-based ownership. Only the authenticated user can access their data.\n\n**QAPs Support:**\n*   The segregation of events and associated data (schedule items, announcements) allows for secure listing of public events without exposing private user data."
  }
}