
{
  "entities": {
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents a hackathon event.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event."
        },
        "name": {
          "type": "string",
          "description": "Name of the event."
        },
        "startDate": {
          "type": "string",
          "description": "Date and time the event starts.",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "Date and time the event ends.",
          "format": "date-time"
        },
        "location": {
          "type": "string",
          "description": "Location of the event."
        },
        "description": {
          "type": "string",
          "description": "Description of the event."
        }
      },
      "required": [
        "id",
        "name",
        "startDate",
        "endDate",
        "location",
        "description"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user participating in the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user."
        },
        "registrationDate": {
          "type": "string",
          "description": "The date the user registered.",
          "format": "date-time"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user has verified their email."
        },
        "college": {
          "type": "string",
          "description": "The user's college or university."
        },
        "skills": {
          "type": "array",
          "description": "Skills possessed by the user.",
          "items": {
            "type": "string"
          }
        },
        "bio": {
          "type": "string",
          "description": "A short bio about the user."
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile picture.",
          "format": "uri"
        },
        "profileBannerUrl": {
          "type": "string",
          "description": "URL of the user's profile banner.",
          "format": "uri"
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's phone number."
        },
        "registrationType": {
          "type": "string",
          "description": "Whether the user registered as an individual or part of a team.",
          "enum": [
            "individual",
            "team"
          ]
        },
        "teamName": {
          "type": "string",
          "description": "The name of the user's team, if applicable."
        },
        "teamMembers": {
          "type": "array",
          "description": "The members of the user's team, if applicable.",
          "items": {
            "type": "string"
          }
        },
        "mentorName": {
          "type": "string",
          "description": "The name of the user's mentor."
        },
        "department": {
          "type": "string",
          "description": "The user's department."
        },
        "leaderName": {
          "type": "string",
          "description": "The name of the team leader, if applicable."
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "registrationDate"
      ]
    },
    "Team": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team",
      "type": "object",
      "description": "Represents a team participating in the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the team."
        },
        "name": {
          "type": "string",
          "description": "Name of the team."
        },
        "memberIds": {
          "type": "array",
          "description": "References to Users. (Relationship: Team 1:N User)",
          "items": {
            "type": "string"
          }
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Team)"
        }
      },
      "required": [
        "id",
        "name",
        "memberIds",
        "eventId"
      ]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a project submitted during the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "teamId": {
          "type": "string",
          "description": "Reference to Team. (Relationship: Team 1:N Project)"
        },
        "name": {
          "type": "string",
          "description": "Name of the project."
        },
        "description": {
          "type": "string",
          "description": "Description of the project."
        },
        "submissionLink": {
          "type": "string",
          "description": "Link to the project submission.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "teamId",
        "name",
        "description",
        "submissionLink"
      ]
    },
    "JudgingCriteria": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "JudgingCriteria",
      "type": "object",
      "description": "Represents criteria used for judging projects.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the judging criteria."
        },
        "name": {
          "type": "string",
          "description": "Name of the criteria."
        },
        "description": {
          "type": "string",
          "description": "Description of the criteria."
        },
        "weight": {
          "type": "number",
          "description": "Weight of the criteria in overall score."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "weight"
      ]
    },
    "Judgment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Judgment",
      "type": "object",
      "description": "Represents a judge's assessment of a project.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the judgment."
        },
        "projectId": {
          "type": "string",
          "description": "Reference to Project. (Relationship: Project 1:N Judgment)"
        },
        "judgeId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Judgment)"
        },
        "criteriaId": {
          "type": "string",
          "description": "Reference to JudgingCriteria. (Relationship: JudgingCriteria 1:N Judgment)"
        },
        "score": {
          "type": "number",
          "description": "Score awarded by the judge for the criteria."
        },
        "feedback": {
          "type": "string",
          "description": "Feedback provided by the judge."
        }
      },
      "required": [
        "id",
        "projectId",
        "judgeId",
        "criteriaId",
        "score",
        "feedback"
      ]
    },
    "Announcement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Announcement",
      "type": "object",
      "description": "Represents an announcement made during the hackathon.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the announcement."
        },
        "eventId": {
          "type": "string",
          "description": "Reference to Event. (Relationship: Event 1:N Announcement)"
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the announcement.",
          "format": "date-time"
        },
        "content": {
          "type": "string",
          "description": "Content of the announcement."
        }
      },
      "required": [
        "id",
        "eventId",
        "timestamp",
        "content"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": {
            "$ref": "#/backend/entities/Event"
          },
          "description": "Stores event details. The 'eventId' parameter is the unique identifier for each event.",
          "params": [
            {
              "name": "eventId",
              "description": "Unique identifier for the event."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. The 'userId' parameter is the unique identifier for each user.",
          "params": [
            {
              "name": "userId",
              "description": "Unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/teams/{teamId}",
        "definition": {
          "entityName": "Team",
          "schema": {
            "$ref": "#/backend/entities/Team"
          },
          "description": "Stores team information, including the members. Includes denormalized 'memberIds' array for authorization independence.",
          "params": [
            {
              "name": "teamId",
              "description": "Unique identifier for the team."
            }
          ]
        }
      },
      {
        "path": "/projects/{projectId}",
        "definition": {
          "entityName": "Project",
          "schema": {
            "$ref": "#/backend/entities/Project"
          },
          "description": "Stores project submission details. The 'projectId' parameter is the unique identifier for each project.",
          "params": [
            {
              "name": "projectId",
              "description": "Unique identifier for the project."
            }
          ]
        }
      },
      {
        "path": "/judgingCriteria/{criteriaId}",
        "definition": {
          "entityName": "JudgingCriteria",
          "schema": {
            "$ref": "#/backend/entities/JudgingCriteria"
          },
          "description": "Stores judging criteria. The 'criteriaId' parameter is the unique identifier for each criterion.",
          "params": [
            {
              "name": "criteriaId",
              "description": "Unique identifier for the judging criteria."
            }
          ]
        }
      },
      {
        "path": "/judgments/{judgmentId}",
        "definition": {
          "entityName": "Judgment",
          "schema": {
            "$ref": "#/backend/entities/Judgment"
          },
          "description": "Stores judge's assessments of projects. The 'judgmentId' parameter is the unique identifier for each judgment.",
          "params": [
            {
              "name": "judgmentId",
              "description": "Unique identifier for the judgment."
            }
          ]
        }
      },
      {
        "path": "/announcements/{announcementId}",
        "definition": {
          "entityName": "Announcement",
          "schema": {
            "$ref": "#/backend/entities/Announcement"
          },
          "description": "Stores event announcements. The 'announcementId' parameter is the unique identifier for each announcement.",
          "params": [
            {
              "name": "announcementId",
              "description": "Unique identifier for the announcement."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore data structure is designed to support the HackTrack application's core features, emphasizing security, scalability, and ease of debugging. Authorization Independence is achieved through denormalization, particularly for team membership, and segregation is used to ensure consistent security postures within collections.\n\n*   **Authorization Independence**: The `teams` collection includes a `members` map that denormalizes user roles within the team. This eliminates the need for `get()` calls to the `users` collection to check a user's role when accessing team data. Similarly, the `projects` collection could denormalize team membership or even the event ID to simplify rules.\n*   **Structural Segregation:** Events and Users are placed in top-level collections because of their fundamentally different access requirements. User specific data is organized under the `/users/{userId}` path.\n*   **Access Modeling**: Path-based ownership (`/users/{userId}/...`) is used for private user data. Membership Maps (`members: {uid: role}`) are employed for collaborative data like teams, facilitating straightforward role-based access control.\n*   **QAPs (Rules are not Filters)**: The structure enables secure list operations by avoiding reliance on server-side filtering. For example, listing public events can be done directly from the `/events` collection without needing complex rule logic.\n\nThis structure supports the application's requirements for event schedules, registration, live updates, submission platform, judging system, and team formation, while adhering to the core design principles."
  }
}
