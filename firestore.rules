/**
 * @file Firebase Security Rules for HackTrack Firestore Database
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for personal data and a role-based model for administrative tasks.
 * Public read access is granted to certain collections like 'events' and 'announcements', but write access is strictly controlled.
 *
 * Data Structure:
 * - /users/{userId}: Stores personal user profiles; access is restricted to the owner for writes, but readable by any signed-in user for team-finding purposes.
 * - /events/{eventId}: Stores event details; publicly readable.
 * - /events/{eventId}/scheduleItems/{scheduleItemId}: Stores schedule items for events; publicly readable.
 * - /announcements: Stores announcements for events; readable by authenticated users.
 * - /teams/{teamId}: Stores team data, with memberIDs for authorization.
 * - /projects/{projectId}: Stores project submissions associated with teams.
 * - /judgingAssignments/{judgingAssignmentId}: Stores judge assignments and scores.
 * - /judgingCriteria/{judgingCriteriaId}: Stores criteria used for judging.
 * - /judges/{judgeId}: Stores judge information.
 * - /roles_event_admin/{userId}: Collection to store event administrator roles; existence of document indicates admin role.
 *
 * Key Security Decisions:
 * - User listing is allowed for any authenticated user to facilitate team formation.
 * - Public read access is granted to 'events' and 'scheduleItems'.
 * - Authenticated users can read 'announcements'.
 * - Only team members can access the team projects.
 * - Roles for Event Admins are determined by presence of a document in `/roles_event_admin/{uid}`.
 *
 * Denormalization for Authorization:
 * - The 'teams' collection relies on the 'memberIDs' array within each document to authorize access to team-related resources.
 * - Event-related data (schedule items) are stored in subcollections under `/events/{eventId}`, with the `eventID` field in each document ensuring association with the correct event.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Secure user profiles; only the owner can read or write their own profile.
     * @path: /users/{userId}
     * @allow: (create) User 'user123' can create /users/user123.
     * @deny: (create) User 'user456' cannot create /users/user123.
     * @principle: Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isSignedIn(); // Allow authenticated users to list profiles for team building.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id; // Enforce immutability
      allow delete: if isOwner(userId) && resource != null; // Check document existence before deletion.
    }

    /**
     * @description: Allow public read access to events; restrict write access.
     * @path: /events/{eventId}
     * @allow: (get) Any user can read event details.
     * @deny: (create) Non-admin user cannot create events.
     * @principle: Public read access with restricted write access.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null; // Check document existence before update.
      allow delete: if isAdmin() && resource != null; // Check document existence before deletion.
    }

    /**
     * @description: Allow public read access to schedule items; restrict write access to admins.
     * @path: /events/{eventId}/scheduleItems/{scheduleItemId}
     * @allow: (get) Any user can read schedule items.
     * @deny: (create) Non-admin user cannot create schedule items.
     * @principle: Public read access with restricted write access.
     */
    match /events/{eventId}/scheduleItems/{scheduleItemId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null; // Check document existence before update.
      allow delete: if isAdmin() && resource != null; // Check document existence before deletion.
    }
    
    /**
     * @description: Allow authenticated users to read announcements; restrict write access to admins.
     * @path: /announcements/{announcementId}
     * @allow: (get, list) Authenticated users can read announcements.
     * @deny: (create) Non-admin user cannot create announcements.
     * @principle: Authenticated read access with restricted write access.
     */
    match /announcements/{announcementId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }


    /**
     * @description: Secure team data; only team members can read or write team data.
     * @path: /teams/{teamId}
     * @allow: (get) Team member 'user123' can read team details.
     * @deny: (get) Non-team member 'user456' cannot read team details.
     * @principle: Enforces shared access based on team membership.
     */
    match /teams/{teamId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isTeamMember(teamId) {
            return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIDs;
        }

        allow get, list: if isTeamMember(teamId);
        allow create: if isSignedIn(); // Any signed-in user can create a team
        allow update: if isTeamMember(teamId) && resource != null; // Check document existence before update.
        allow delete: if isTeamMember(teamId) && resource != null; // Check document existence before deletion.
    }

    /**
     * @description: Secure project submissions; only team members can access project details.
     * @path: /projects/{projectId}
     * @allow: (get) Team member 'user123' can read project details.
     * @deny: (get) Non-team member 'user456' cannot read project details.
     * @principle: Enforces shared access based on team membership.
     */
    match /projects/{projectId} {
        function isSignedIn() {
            return request.auth != null;
        }

       function getTeamIdForProject(projectId) {
            return get(/databases/$(database)/documents/projects/$(projectId)).data.teamID;
        }

        function isTeamMember(teamId) {
            return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIDs;
        }

        allow get, list: if isSignedIn() && isTeamMember(getTeamIdForProject(projectId));
        allow create: if isSignedIn(); // Any signed-in user can create a project.
        allow update: if isSignedIn() && isTeamMember(getTeamIdForProject(projectId)) && resource != null; // Check document existence before update.
        allow delete: if isSignedIn() && isTeamMember(getTeamIdForProject(projectId)) && resource != null; // Check document existence before deletion.
    }

    /**
     * @description: Secure judging assignments; only judges can access judging assignments.
     * @path: /judgingAssignments/{judgingAssignmentId}
     * @allow: (get) Judge 'judge123' can read their judging assignments.
     * @deny: (get) Non-judge 'user456' cannot read judging assignments.
     */
    match /judgingAssignments/{judgingAssignmentId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isJudge(judgeId) {
            return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/judges/$(judgeId)).data.id;
        }

        function getJudgeIdForAssignment(judgingAssignmentId) {
            return get(/databases/$(database)/documents/judgingAssignments/$(judgingAssignmentId)).data.judgeID;
        }
        allow get, list: if isSignedIn() && isJudge(getJudgeIdForAssignment(judgingAssignmentId));
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isJudge(getJudgeIdForAssignment(judgingAssignmentId)) && resource != null; // Check document existence before update.
        allow delete: if isSignedIn() && isJudge(getJudgeIdForAssignment(judgingAssignmentId)) && resource != null; // Check document existence before deletion.
    }

    /**
     * @description: Allow public read access to judging criteria; restrict write access to admins.
     * @path: /judgingCriteria/{judgingCriteriaId}
     * @allow: (get) Any user can read judging criteria.
     * @deny: (create) Non-admin user cannot create judging criteria.
     * @principle: Public read access with restricted write access.
     */
    match /judgingCriteria/{judgingCriteriaId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null; // Check document existence before update.
      allow delete: if isAdmin() && resource != null; // Check document existence before deletion.
    }

    /**
     * @description: Secure judge data; restrict access to admins.
     * @path: /judges/{judgeId}
     */
    match /judges/{judgeId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null; // Check document existence before update.
      allow delete: if isAdmin() && resource != null; // Check document existence before deletion.
    }

     /**
      * @description: Secure event admin role assignment; only admins can assign event admin roles.
      * @path: /roles_event_admin/{userId}
      */
     match /roles_event_admin/{userId} {
        allow get: if isAdmin();
        allow list: if false; // Prevent listing of event admins
        allow create: if isAdmin();
        allow update: if false; // Prevent updates
        allow delete: if isAdmin() && resource != null; // Check document existence before deletion.
     }

     /**
      * @description: Check if the user is an admin.
      */
    function isAdmin() {
       return exists(/databases/$(database)/documents/roles_event_admin/$(request.auth.uid));
    }
  }
}
