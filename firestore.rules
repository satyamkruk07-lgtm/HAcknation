/**
 * @fileoverview Firestore Security Rules for HackTrack application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict ownership for user data and leveraging denormalization to avoid costly `get()` calls.  It allows public read access to some collections like `events`, but restricts write access based on authentication.
 *
 * Data Structure:
 * The data is organized into top-level collections like `/events`, `/users`, `/teams`, `/submissions`, `/judgingCriteria`, `/judges`, and `/scores`.
 * User-specific data is stored under the `/users/{userId}` path.
 * Event-related data (schedule items, announcements) are nested under `/events/{eventId}`.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed (no `allow list: if true;` on `/users`).
 * - Public read access (`allow get, list: if true;`) is granted for the `/events` collection, but write access is restricted.
 * - All write operations require authentication (`isSignedIn()`).
 * - Denormalization of `eventId` in subcollections like `/events/{eventId}/scheduleItems` and `/events/{eventId}/announcements` enables efficient authorization checks without additional reads.
 *
 * Denormalization for Authorization:
 * - The 'ScheduleItem' and 'Announcement' entities under an event include the 'eventId' to allow validation of the parent event during write operations without needing a `get()` call.
 *
 * Structural Segregation:
 * - Public event data is stored in the top-level `/events` collection, while private user data is stored under `/users/{userId}`, ensuring a clear separation of access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @param   {}
     * @return  {bool}
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param   {string} userId - The user ID to compare against the authenticated user ID.
     * @return  {bool} - True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing resource.
     * @param   {string} userId - The user ID to compare against the authenticated user ID.
     * @return  {bool} - True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /events collection.
     * @path /events/{eventId}
     * @allow (get, list): Any user can read event details.
     * @allow (create): Only authenticated users can create events, and the 'id' field must match the eventId.
     * @allow (update, delete): Only authenticated users can update/delete events.
     * @deny  (create): Unauthenticated users cannot create events.
     * @deny  (update, delete): Unauthenticated users cannot update/delete events.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /users collection. Enforces strict user-ownership.
     * @path /users/{userId}
     * @allow (create): The authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (get): Only the authenticated user can read their own profile.
     * @allow (update, delete): Only the authenticated user can update/delete their own profile, and only if the document exists.
     * @deny (list): Listing all users is not allowed.
     * @deny (create): Creating a user profile with a mismatched userId is not allowed.
     * @deny (update, delete): Updating/deleting another user's profile is not allowed.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if false;
    }

    /**
     * @description Rules for the /teams collection.
     * @path /teams/{teamId}
     * @allow (get, list): Any user can read team details.
     * @allow (create): Only authenticated users can create teams.
     * @allow (update, delete): Only authenticated users can update/delete teams.
     * @deny  (create): Unauthenticated users cannot create teams.
     * @deny  (update, delete): Unauthenticated users cannot update/delete teams.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /teams/{teamId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /events/{eventId}/scheduleItems collection.
     *              Requires the eventId in the path to match the eventId in the document.
     * @path /events/{eventId}/scheduleItems/{scheduleItemId}
     * @allow (get, list): Any user can read schedule item details.
     * @allow (create): Only authenticated users can create schedule items.
     * @allow (update, delete): Only authenticated users can update/delete schedule items.
     * @deny  (create): Unauthenticated users cannot create schedule items.
     * @deny  (update, delete): Unauthenticated users cannot update/delete schedule items.
     * @principle Allows public reads, restricts writes to authenticated users, validates eventId.
     */
    match /events/{eventId}/scheduleItems/{scheduleItemId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /events/{eventId}/announcements collection.
     *              Requires the eventId in the path to match the eventId in the document.
     * @path /events/{eventId}/announcements/{announcementId}
     * @allow (get, list): Any user can read announcement details.
     * @allow (create): Only authenticated users can create announcements.
     * @allow (update, delete): Only authenticated users can update/delete announcements.
     * @deny  (create): Unauthenticated users cannot create announcements.
     * @deny  (update, delete): Unauthenticated users cannot update/delete announcements.
     * @principle Allows public reads, restricts writes to authenticated users, validates eventId.
     */
    match /events/{eventId}/announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /submissions collection.
     * @path /submissions/{submissionId}
     * @allow (get, list): Any user can read submission details.
     * @allow (create): Only authenticated users can create submissions.
     * @allow (update, delete): Only authenticated users can update/delete submissions.
     * @deny  (create): Unauthenticated users cannot create submissions.
     * @deny  (update, delete): Unauthenticated users cannot update/delete submissions.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /judgingCriteria collection.
     * @path /judgingCriteria/{judgingCriteriaId}
     * @allow (get, list): Any user can read judging criteria details.
     * @allow (create): Only authenticated users can create judging criteria.
     * @allow (update, delete): Only authenticated users can update/delete judging criteria.
     * @deny  (create): Unauthenticated users cannot create judging criteria.
     * @deny  (update, delete): Unauthenticated users cannot update/delete judging criteria.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /judgingCriteria/{judgingCriteriaId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /judges collection.
     * @path /judges/{judgeId}
     * @allow (get, list): Any user can read judge details.
     * @allow (create): Only authenticated users can create judges.
     * @allow (update, delete): Only authenticated users can update/delete judges.
     * @deny  (create): Unauthenticated users cannot create judges.
     * @deny  (update, delete): Unauthenticated users cannot update/delete judges.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /judges/{judgeId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /scores collection.
     * @path /scores/{scoreId}
     * @allow (get, list): Any user can read score details.
     * @allow (create): Only authenticated users can create scores.
     * @allow (update, delete): Only authenticated users can update/delete scores.
     * @deny  (create): Unauthenticated users cannot create scores.
     * @deny  (update, delete): Unauthenticated users cannot update/delete scores.
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /scores/{scoreId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}